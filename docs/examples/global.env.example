# Copy to .local/credentials/.env (private, ignored by Git).
# Shared by all clusters. Format: user@realm!token-name=token-secret
PROXMOX_VE_API_TOKEN=''

# Cloudflare account-wide resources; API token and account ID are different.
CLOUDFLARE_API_TOKEN=''
CLOUDFLARE_ACCOUNT_ID=''

# Optional public-key file override; defaults to this path under the repository.
# HOMELAB_SSH_PUBLIC_KEY_FILE='/absolute/path/to/homelab/.local/credentials/node_public_key.pub'
