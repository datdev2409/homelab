# Global environment for the repository and every cluster.
export HOMELAB_REPOSITORY_ROOT="$PWD"
watch_file "$PWD/.local/credentials/.env"
dotenv_if_exists "$PWD/.local/credentials/.env"
export TG_TF_PATH="${TG_TF_PATH:-tofu}"

# Public key only; credentials may supply a different key explicitly.
export HOMELAB_SSH_PUBLIC_KEY_FILE="${HOMELAB_SSH_PUBLIC_KEY_FILE:-$HOMELAB_REPOSITORY_ROOT/.local/credentials/node_public_key.pub}"
watch_file "$HOMELAB_SSH_PUBLIC_KEY_FILE"
if [[ -z "${HOMELAB_SSH_PUBLIC_KEY:-}" && -f "$HOMELAB_SSH_PUBLIC_KEY_FILE" ]]; then
  export HOMELAB_SSH_PUBLIC_KEY="$(cat "$HOMELAB_SSH_PUBLIC_KEY_FILE")"
fi
