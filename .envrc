# Global environment for the repository and every cluster.
export HOMELAB_REPOSITORY_ROOT="$PWD"
watch_file "$PWD/.local/credentials/.env"
dotenv_if_exists "$PWD/.local/credentials/.env"
export TG_TF_PATH="${TG_TF_PATH:-tofu}"

# Public key only; credentials may supply a different key explicitly.
watch_file "$PWD/.local/credentials/node_public_key.pub"
if [[ -z "${HOMELAB_SSH_PUBLIC_KEY:-}" && -f "$PWD/.local/credentials/node_public_key.pub" ]]; then
  export HOMELAB_SSH_PUBLIC_KEY="$(cat "$PWD/.local/credentials/node_public_key.pub")"
fi
